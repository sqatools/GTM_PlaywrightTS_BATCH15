{
  "name": "saucedemo-playwright-bdd",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright and Cucumber BDD tests for SauceDemo",
  "scripts": {
    "test": "cucumber-js",
    "test:smoke": "cucumber-js --tags @smoke",
    "test:regression": "cucumber-js --tags @regression",
    "test:allure": "npm test && npm run allure:generate",
    "allure:generate": "allure generate reports/allure-results --clean -o reports/allure-report",
    "allure:open": "allure open reports/allure-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@types/node": "^22.15.30",
    "allure-commandline": "^2.46.1",
    "allure-cucumberjs": "^3.13.0",
    "playwright": "^1.52.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
